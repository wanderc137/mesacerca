# MesaCerca — ejemplo de variables de entorno
# Copia este archivo a .env y completa los valores.
# Nunca subas .env, credenciales reales ni claves privadas al repositorio.

# ── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# ── Base de datos ─────────────────────────────────────────────────────────────
# Desarrollo local: PostgreSQL en 127.0.0.1:5433 (ver scripts/local-postgres.sh).
# Producción: usa sslmode=verify-full y la CA del proveedor.
DATABASE_URL="postgresql://mesacerca:mesacerca@127.0.0.1:5433/mesacerca?schema=public"
POSTGRES_PASSWORD="cambia-esta-clave"

# ── Sesiones y trabajos internos ──────────────────────────────────────────────
# Genera cada secreto con: openssl rand -base64 48
AUTH_SECRET="cambia-este-secreto-por-uno-aleatorio-de-48-bytes"
CRON_SECRET="cambia-este-secreto-por-uno-aleatorio-de-48-bytes"

# ── Red / proxy ───────────────────────────────────────────────────────────────
# En producción detrás de Cloudflare/Caddy: 1. En local: 0.
TRUST_PROXY=0
# Orígenes permitidos para la API (Expo web, previews). Separados por coma.
CORS_ORIGINS="http://localhost:8081,http://127.0.0.1:8081"

# ── Pagos ─────────────────────────────────────────────────────────────────────
# mock | sandbox | production
PAYMENTS_MODE="mock"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
TRANSBANK_COMMERCE_CODE=""
TRANSBANK_API_KEY=""
# integration | production
TRANSBANK_ENVIRONMENT="integration"

# ── Seguridad de cuentas ──────────────────────────────────────────────────────
# En producción deben ser true; el arranque las exige.
MFA_ENFORCED=false
# 32 bytes en base64 para AES-256-GCM. Genera con: openssl rand -base64 32
MFA_ENCRYPTION_KEY=""
KYC_REQUIRED=false
EMAIL_VERIFICATION_REQUIRED=false
COURIER_SECURITY_ENFORCED=false

# ── KYC (Didit) ───────────────────────────────────────────────────────────────
# didit | (vacío para desactivar)
KYC_PROVIDER=""
DIDIT_API_KEY=""
# Solo para crear/editar workflows; no la uses en runtime.
DIDIT_WORKFLOW_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_CALLBACK_URL=""
DIDIT_WEBHOOK_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="MesaCerca <no-reply@mesacerca.cl>"

# ── SMS (Twilio, opcional) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ── Infraestructura (solo despliegue) ─────────────────────────────────────────
DOMAIN=""
TLS_CERT=""
TLS_KEY=""
CLOUDFLARE_TUNNEL_TOKEN=""
BACKUP_PASSPHRASE=""

# ── App móvil (Expo) ──────────────────────────────────────────────────────────
# Si no se define, la app intenta detectar la IP desde Metro.
EXPO_PUBLIC_API_URL=""
EXPO_PUBLIC_WEB_URL=""
